{
  "name": "webflow-loader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@latest",
  "scripts": {
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "check": "pnpm lint && pnpm format:check",
    "build": "esbuild src/loader.js --minify --outfile=dist/loader.js",
    "deploy:loader": "pnpm fix && pnpm check && pnpm build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
